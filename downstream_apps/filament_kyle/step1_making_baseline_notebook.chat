            "raw_output": "207:    # data order is pinned, so changing the seed is how you get a genuinely different run.\n208:    seed: int = 42\n229:        # A quoted seed in YAML (\"42\") would otherwise reach torch.manual_seed as a str\n231:        if isinstance(self.seed, bool) or not isinstance(self.seed, int):\n233:                f\"training.seed must be an integer, got {self.seed!r} \"\n234:                f\"({type(self.seed).__name__}). Write it unquoted in the YAML, e.g. seed: 42.\"\n370:        seed=training.get(\"seed\", 42),\n384:    \"learning_rate\", \"max_epochs\", \"batch_size\", \"num_workers\", \"seed\", \"deterministic\",\nShell cwd was reset to /home/jovyan/surya_workshop/downstream_apps/filament_kyle",
