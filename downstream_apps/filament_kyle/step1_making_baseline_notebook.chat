      "metadata": {
        "tool_calls": [
          {
            "kind": "execute",
            "raw_output": "51-  ds_time_column: start_time      # Column in the filament catalog used as the event timestamp\n52-  ds_time_tolerance: 2d           # Max allowed gap between catalog and Surya timestamps\n53:  ds_match_direction: forward     # \"forward\": use solar state *before* the flare (causal)\nShell cwd was reset to /home/jovyan/surya_workshop/downstream_apps/filament_kyle",
            "permission_status": "resolved",
            "title": "source conda.sh && conda activate surya_ws && cd surya_workshop && grep -n \"ds_match_direction: forward\" -A0 -B2 downstream_apps/filament_kyle/configs/config_script.yaml",
            "selected_option_id": "allow-once",
            "raw_input": {
              "command": "source /srv/conda/etc/profile.d/conda.sh && conda activate /home/jovyan/envs/surya_ws && cd /home/jovyan/surya_workshop && grep -n \"ds_match_direction: forward\" -A0 -B2 downstream_apps/filament_kyle/configs/config_script.yaml"
