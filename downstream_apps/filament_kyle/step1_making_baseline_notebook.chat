            "title": "cd surya_workshop && python3 << 'EOF' import boto3, pandas as pd from botocore import UNSIGNED from botocore.config import Config s3 = boto3.client('s3', config=Config(signature_version=UNSIGNED)) events = [ \"2012-03-05T04:00:05\", \"2012-03-07T00:24:06\", \"2012-03-07T01:30:06\", \"2012-03-13T17:36:05\", \"2012-03-15T07:12:05\", \"2012-04-23T18:24:05\", \"2012-06-14T14:12:07\", \"2012-07-12T16:48:05\", \"2012-09-28T00:12:05\", \"2013-11-07T15:12:10\", \"2015-03-15T01:48:05\", ] def list_day(dt): prefix = f\"{dt.year:04d}/{dt.month:02d}/{dt.year:04d}{dt.month:02d}{dt.day:02d}_\" paginator = s3.get_paginator('list_objects_v2') keys = [] for page in paginator.paginate(Bucket='nasa-surya-bench', Prefix=prefix): for obj in page.get('Contents', []): keys.append(obj['Key']) return sorted(keys) def parse_times(keys): out = [] for k in keys: fname = k.split('/')[-1] datepart, timepart = fname.replace('.nc', '').split('_') t = pd.Timestamp(f\"{datepart[:4]}-{datepart[4:6]}-{datepart[6:8]} {timepart[:2]}:{timepart[2:4]}:00\") out.append((t, k)) return out rows = [] for e in events: ts = pd.Timestamp(e) times_keys = parse_times(list_day(ts)) fwd = sorted([tk for tk in times_keys if tk[0] >= ts]) if not fwd: ts2 = ts + pd.Timedelta(days=1) times_keys += parse_times(list_day(ts2)) fwd = sorted([tk for tk in times_keys if tk[0] >= ts]) match_t, match_k = fwd[0] rows.append({ \"path\": f\"s3://nasa-surya-bench/{match_k}\", \"timestep\": match_t, \"present\": 1, \"dayofyear\": match_t.dayofyear, }) df = pd.DataFrame(rows).sort_values(\"timestep\").reset_index(drop=True) out_path = \"downstream_apps/filament_kyle/data/surya_index_filament_events.csv\" df.to_csv(out_path, index=False) print(df) print(\"Wrote\", out_path) EOF",
            "tool_call_id": "toolu_bdrk_01RWd17XaNYgvpqhmuAqe2wN",
            "kind": "execute",
            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop && python3 << 'EOF'\nimport boto3, pandas as pd\nfrom botocore import UNSIGNED\nfrom botocore.config import Config\n\ns3 = boto3.client('s3', config=Config(signature_version=UNSIGNED))\n\nevents = [\n    \"2012-03-05T04:00:05\",\n    \"2012-03-07T00:24:06\",\n    \"2012-03-07T01:30:06\",\n    \"2012-03-13T17:36:05\",\n    \"2012-03-15T07:12:05\",\n    \"2012-04-23T18:24:05\",\n    \"2012-06-14T14:12:07\",\n    \"2012-07-12T16:48:05\",\n    \"2012-09-28T00:12:05\",\n    \"2013-11-07T15:12:10\",\n    \"2015-03-15T01:48:05\",\n]\n\ndef list_day(dt):\n    prefix = f\"{dt.year:04d}/{dt.month:02d}/{dt.year:04d}{dt.month:02d}{dt.day:02d}_\"\n    paginator = s3.get_paginator('list_objects_v2')\n    keys = []\n    for page in paginator.paginate(Bucket='nasa-surya-bench', Prefix=prefix):\n        for obj in page.get('Contents', []):\n            keys.append(obj['Key'])\n    return sorted(keys)\n\ndef parse_times(keys):\n    out = []\n    for k in keys:\n        fname = k.split('/')[-1]\n        datepart, timepart = fname.replace('.nc', '').split('_')\n        t = pd.Timestamp(f\"{datepart[:4]}-{datepart[4:6]}-{datepart[6:8]} {timepart[:2]}:{timepart[2:4]}:00\")\n        out.append((t, k))\n    return out\n\nrows = []\nfor e in events:\n    ts = pd.Timestamp(e)\n    times_keys = parse_times(list_day(ts))\n    fwd = sorted([tk for tk in times_keys if tk[0] >= ts])\n    if not fwd:\n        ts2 = ts + pd.Timedelta(days=1)\n        times_keys += parse_times(list_day(ts2))\n        fwd = sorted([tk for tk in times_keys if tk[0] >= ts])\n    match_t, match_k = fwd[0]\n    rows.append({\n        \"path\": f\"s3://nasa-surya-bench/{match_k}\",\n        \"timestep\": match_t,\n        \"present\": 1,\n        \"dayofyear\": match_t.dayofyear,\n    })\n\ndf = pd.DataFrame(rows).sort_values(\"timestep\").reset_index(drop=True)\nout_path = \"downstream_apps/filament_kyle/data/surya_index_filament_events.csv\"\ndf.to_csv(out_path, index=False)\nprint(df)\nprint(\"Wrote\", out_path)\nEOF\n"
            },
