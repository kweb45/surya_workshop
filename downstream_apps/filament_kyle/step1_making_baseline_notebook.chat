            "title": "source conda.sh && conda activate surya_ws && cd surya_workshop && python3 << 'EOF' import boto3, pandas as pd from botocore import UNSIGNED from botocore.config import Config s3 = boto3.client('s3', config=Config(signature_version=UNSIGNED)) events = [ \"2012-03-05T04:00:05\", \"2012-03-07T00:24:06\", \"2012-03-07T01:30:06\", \"2012-03-13T17:36:05\", \"2012-03-15T07:12:05\", \"2012-04-23T18:24:05\", \"2012-06-14T14:12:07\", \"2012-07-12T16:48:05\", \"2012-09-28T00:12:05\", \"2013-11-07T15:12:10\", \"2015-03-15T01:48:05\", ] def list_day(dt): prefix = f\"{dt.year:04d}/{dt.month:02d}/{dt.year:04d}{dt.month:02d}{dt.day:02d}_\" paginator = s3.get_paginator('list_objects_v2') keys = [] for page in paginator.paginate(Bucket='nasa-surya-bench', Prefix=prefix): for obj in page.get('Contents', []): keys.append(obj['Key']) return sorted(keys) def parse_times(keys): out = [] for k in keys: fname = k.split('/')[-1] datepart, timepart = fname.replace('.nc', '').split('_') t = pd.Timestamp(f\"{datepart[:4]}-{datepart[4:6]}-{datepart[6:8]} {timepart[:2]}:{timepart[2:4]}:00\") out.append((t, k)) return out rows = [] for e in events: ts = pd.Timestamp(e) times_keys = parse_times(list_day(ts)) back = sorted([tk for tk in times_keys if tk[0] <= ts]) if not back: ts_prev = ts - pd.Timedelta(days=1) times_keys += parse_times(list_day(ts_prev)) back = sorted([tk for tk in times_keys if tk[0] <= ts]) match_t, match_k = back[-1] # latest one <= event time delta = ts - match_t rows.append({ \"event_start_time\": e, \"path\": f\"s3://nasa-surya-bench/{match_k}\", \"timestep\": match_t, \"present\": 1, \"dayofyear\": match_t.dayofyear, \"delta_before_event\": str(delta), }) df = pd.DataFrame(rows) print(df[[\"event_start_time\",\"timestep\",\"delta_before_event\"]].to_string()) out_df = df[[\"path\",\"timestep\",\"present\",\"dayofyear\"]].sort_values(\"timestep\").reset_index(drop=True) out_path = \"downstream_apps/filament_kyle/data/surya_index_filament_events.csv\" out_df.to_csv(out_path, index=False) print(\"\\nWrote\", out_path) EOF"
