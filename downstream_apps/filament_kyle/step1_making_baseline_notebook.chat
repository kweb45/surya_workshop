              "command": "cd /home/jovyan/surya_workshop && python3 << 'EOF'\nimport boto3, pandas as pd\nfrom botocore import UNSIGNED\nfrom botocore.config import Config\n\ns3 = boto3.client('s3', config=Config(signature_version=UNSIGNED))\n\nevents = [\n    \"2012-03-05T04:00:05\",\n    \"2012-03-07T00:24:06\",\n    \"2012-03-07T01:30:06\",\n    \"2012-03-13T17:36:05\",\n    \"2012-03-15T07:12:05\",\n    \"2012-04-23T18:24:05\",\n    \"2012-06-14T14:12:07\",\n    \"2012-07-12T16:48:05\",\n    \"2012-09-28T00:12:05\",\n    \"2013-11-07T15:12:10\",\n    \"2015-03-15T01:48:05\",\n]\n\ndef list_day(dt):\n    prefix = f\"{dt.year:04d}/{dt.month:02d}/{dt.year:04d}{dt.month:02d}{dt.day:02d}_\"\n    paginator = s3.get_paginator('list_objects_v2')\n    keys = []\n    for page in paginator.paginate(Bucket='nasa-surya-bench', Prefix=prefix):\n        for obj in page.get('Contents', []):\n            keys.append(obj['Key'])\n    return sorted(keys)\n\nrows = []\nfor e in events:\n    ts = pd.Timestamp(e)\n    keys = list_day(ts)\n    times_keys = []\n    for k in keys:\n        fname = k.split('/')[-1]\n        datepart, timepart = fname.replace('.nc','').split('_')\n        t = pd.Timestamp(f\"{datepart[:4]}-{datepart[4:6]}-{datepart[6:8]} {timepart[:2]}:{timepart[2:4]}:00\")\n        times_keys.append((t, k))\n    times_keys.sort()\n    fwd = [(t,k) for t,k in times_keys if t >= ts]\n    if not fwd:\n        # check next day too\n        ts2 = ts + pd.Timedelta(days=1)\n        keys2 = list_day(ts2)\n        for k in keys2:\n            fname = k.split('/')[-1]\n            datepart, timepart = fname.replace('.nc','').split('_')\n            t = pd.Timestamp(f\"{datepart[:4]}-{datepart[4:6]}-{datepart[6:8]} {timepart[:2]}:{timepart[2:4]}:00\")\n            times_keys.append((t,k))\n        times_keys.sort()\n        fwd = [(t,k) for t,k in times_keys if t >= ts]\n    match_t, match_k = fwd[0]\n    delta = match_t - ts\n    rows.append({\n        \"event_start_time\": e,\n        \"path\": f\"s3://nasa-surya-bench/{match_k}\",\n        \"timestep\": match_t,\n        \"present\": 1,\n        \"dayofyear\": match_t.dayofyear,\n        \"delta_to_event\": str(delta),\n    })\n\ndf = pd.DataFrame(rows)\nprint(df.to_string())\nEOF\n"
