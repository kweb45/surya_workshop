              "old_string": "        if filament_index_path is not None:\n            self.ds_index = pd.read_csv(filament_index_path)\n        else:\n            raise ValueError(\"filament_index_path must be provided for FilamentDataset\")\n\n        # self.ds_index = pd.read_csv(ds_flare_index_path)\n\n        # self.ds_index[\"hemisphere\"] = self.ds_index[\"hemisphere\"].str.lower()\n\n        # self.ds_index[\"label\"] = self.ds_index[\"hemisphere\"].map({\n        #     \"north\": 0,\n        #     \"south\": 1,\n        # })\n\n        if not self.ds_index[\"hemisphere\"].isin([0, 1]).all():\n            raise ValueError(\"hemisphere column must contain only 0 or 1\")\n        self.ds_index[\"label\"] = self.ds_index[\"hemisphere\"].astype(np.float32)\n\n        if self.ds_index[\"label\"].isna().any():\n            raise ValueError(\"Hemisphere must be either 'North' or 'South'\")",
