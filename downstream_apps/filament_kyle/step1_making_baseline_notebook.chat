            "kind": "read",
            "raw_output": "460\t            raise ValueError(\n461\t                \"channels is required. Pass the NetCDF variable names to load, e.g. the 13 \"\n462\t                \"Surya channels:\\n\"\n463\t                \"    ['aia94', 'aia131', 'aia171', 'aia193', 'aia211', 'aia304', 'aia335',\\n\"\n464\t                \"     'aia1600', 'hmi_m', 'hmi_bx', 'hmi_by', 'hmi_bz', 'hmi_v']\\n\"\n465\t                \"The names must match the keys in your scalers.yaml.\"\n466\t            )\n467\t\n468\t        self.channels = channels\n469\t        self.in_channels = len(self.channels)\n470\t\n471\t        self.masker = RandomChannelMaskerTransform(\n472\t            num_channels=self.in_channels,\n473\t            num_mask_aia_channels=self.num_mask_aia_channels,\n474\t            phase=self.phase,\n475\t            drop_hmi_probability=self.drop_hmi_probability,\n476\t        )\n477\t\n478\t        self.time_delta_input_minutes = sorted(\n479\t            np.timedelta64(t, \"m\") for t in time_delta_input_minutes\n480\t        )\n481\t        # range(1, rollout_steps + 2): starts at 1\u00d7 (first target), ends at (rollout_steps + 1)\u00d7.\n482\t        # rollout_steps=0 \u2192 one target frame; rollout_steps=N \u2192 N+1 target frames.\n483\t        self.time_delta_target_minutes = [\n484\t            np.timedelta64(iroll * time_delta_target_minutes, \"m\")\n485\t            for iroll in range(1, rollout_steps + 2)\n486\t        ]\n487\t\n488\t        self.index = pd.read_csv(index_path)\n489\t        self.index = self.index[self.index[\"present\"] == 1]\n490\t        self.index[\"timestep\"] = pd.to_datetime(self.index[\"timestep\"]).values.astype(\"datetime64[ns]\")\n491\t        self.index.set_index(\"timestep\", inplace=True)\n492\t        self.index.sort_index(inplace=True)\n493\t\n494\t        self._validate_s3_cache_dir(index_path)\n495\t\n496\t        self.valid_indices = self._filter_valid_indices()\n497\t        self.adjusted_length = len(self.valid_indices)\n498\t\n499\t        self.rank = get_rank()\n500\t        self.logger: Logger | None = None\n501\t\n502\t        # Every requested channel must have a scaler. Checking here turns what would\n503\t        # otherwise be a bare `KeyError: 'aia1700'` from the comprehension below into a\n504\t        # message naming the config key, the missing channels, and the valid ones.\n505\t        missing = [ch for ch in self.channels if ch not in self.scalers]\n506\t        if missing:\n507\t            raise ValueError(\n508\t                f\"No scaler found for channel(s): {', '.join(missing)}.\\n\"\n509\t                \"Every entry in data.channels must have matching statistics in your \"\n510\t                \"scalers file (data.scalers_path).\\n\"\n511\t                f\"Channels available in the scalers: {', '.join(sorted(self.scalers))}.\\n\"\n512\t                \"Either correct the channel name in the config or use a scalers file that \"\n513\t                \"covers it.\"\n514\t            )\n515\t\n516\t        # Pre-compute normalization arrays once (avoids repeated dict lookups per sample).\n517\t        self._means = np.array([self.scalers[ch].mean for ch in self.channels])\n518\t        self._stds = np.array([self.scalers[ch].std for ch in self.channels])\n519\t        self._epsilons = np.array([self.scalers[ch].epsilon for ch in self.channels])\n520\t        self._sl_scale_factors = np.array([self.scalers[ch].sl_scale_factor for ch in self.channels])\n521\t\n522\t    # ------------------------------------------------------------------\n523\t    # Index filtering\n524\t    # ------------------------------------------------------------------\n525\t\n526\t    def _filter_valid_indices(self) -> list:\n527\t        \"\"\"Return the list of reference timesteps for which all required offsets are present.\n528\t\n529\t        When ``load_forecast_frames=False``, only input-frame offsets are checked, so the\n530\t        index does not need to contain future timestamps.\n531\t        \"\"\"\n532\t        if self.load_forecast_frames:\n533\t            # `+` concatenates two Python lists of np.timedelta64 objects before deduplication.\n534\t            time_deltas = np.unique(self.time_delta_input_minutes + self.time_delta_target_minutes)\n535\t        else:\n536\t            time_deltas = np.unique(self.time_delta_input_minutes)\n537\t        return [\n538\t            ts for ts in self.index.index\n539\t            if all(ts + dt in self.index.index for dt in time_deltas)\n540\t        ]\n541\t\n542\t    # ------------------------------------------------------------------\n543\t    # Logging\n544\t    # ------------------------------------------------------------------\n545\t\n546\t    def _ensure_logger(self):\n547\t        \"\"\"Create a per-process logger on first use.\"\"\"\n548\t        if self.logger is not None:\n549\t            return\n550\t        os.makedirs(\"logs/data\", exist_ok=True)\n551\t        timestamp = datetime.now().strftime(\"%Y%m%dT%H%M%SZ\")\n552\t        pid = os.getpid()\n553\t        self.logger = create_logger(\n554\t            output_dir=\"logs/data\",\n555\t            dist_rank=self.rank,\n556\t            name=f\"{timestamp}_{self.rank:>03}_data_{self.phase}_{pid}\",\n557\t        )\n558\t\n559\t    # ------------------------------------------------------------------\n560\t    # Dataset interface\n561\t    # ------------------------------------------------------------------\n562\t\n563\t    def __len__(self) -> int:\n564\t        \"\"\"Return the number of valid reference timesteps in this dataset.\"\"\"\n565\t        return self.adjusted_length\n566\t\n567\t    def __getitem__(self, idx: int) -> dict:\n568\t        \"\"\"\n569\t        Load and return a single sample.\n570\t\n571\t        Args:\n572\t            idx: Dataset index.\n573\t\n574\t        Returns:\n575\t            Dictionary with keys:\n576\t                ts (np.ndarray):               (C, T, H, W) \u2014 input frames\n577\t                time_delta_input (np.ndarray): (T,) \u2014 input time offsets in hours (relative to \"now\")\n578\t            When ``load_forecast_frames=True`` (default), also includes:\n579\t                forecast (np.ndarray):         (C, L, H, W) \u2014 target frames\n580\t                lead_time_delta (np.ndarray):  (L,) \u2014 lead times in hours (negative = future)\n581\t            When ``use_latitude_in_learned_flow=True``, also includes:\n582\t                input_latitudes (list[float])\n583\t                forecast_latitude (list[float])  \u2014 only when ``load_forecast_frames=True``\n584\t        \"\"\"\n585\t        self._ensure_logger()\n586\t        self.logger.info(f\"Retrieving index {idx}.\")\n587\t        return self._get_index_data(idx)\n588\t\n589\t    # ------------------------------------------------------------------",
