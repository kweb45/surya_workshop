            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop && python3 << 'EOF'\nimport boto3, pandas as pd\nfrom botocore import UNSIGNED\nfrom botocore.config import Config\n\ns3 = boto3.client('s3', config=Config(signature_version=UNSIGNED))\n\nevents = [\n    \"2012-03-05T04:00:05\",\n    \"2012-03-07T00:24:06\",\n    \"2012-03-07T01:30:06\",\n    \"2012-03-13T17:36:05\",\n    \"2012-03-15T07:12:05\",\n    \"2012-04-23T18:24:05\",\n    \"2012-06-14T14:12:07\",\n    \"2012-07-12T16:48:05\",\n    \"2012-09-28T00:12:05\",\n]\n\ndef list_day(dt):\n    prefix = f\"{dt.year:04d}/{dt.month:02d}/{dt.year:04d}{dt.month:02d}{dt.day:02d}_\"\n    paginator = s3.get_paginator('list_objects_v2')\n    keys = []\n    for page in paginator.paginate(Bucket='nasa-surya-bench', Prefix=prefix):\n        for obj in page.get('Contents', []):\n            keys.append(obj['Key'])\n    return sorted(keys)\n\nfor e in events:\n    ts = pd.Timestamp(e)\n    keys = list_day(ts)\n    # parse timestamps from filenames\n    times = []\n    for k in keys:\n        fname = k.split('/')[-1]  # 20120305_0412.nc\n        datepart, timepart = fname.replace('.nc','').split('_')\n        t = pd.Timestamp(f\"{datepart[:4]}-{datepart[4:6]}-{datepart[6:8]} {timepart[:2]}:{timepart[2:4]}:00\")\n        times.append(t)\n    times = sorted(times)\n    fwd = [t for t in times if t >= ts]\n    match = fwd[0] if fwd else None\n    within_tol = match is not None and (match - ts) <= pd.Timedelta(\"2d\")\n    print(e, \"-> n_files_that_day:\", len(times), \" nearest_forward:\", match, \" within_2d_tol:\", within_tol)\nEOF\n"
            },
