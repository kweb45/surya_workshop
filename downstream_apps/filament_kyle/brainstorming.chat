            "title": "Read datasets/filament_dataset.py",
            "status": "completed",
            "raw_output": "1\timport numpy as np\n2\timport pandas as pd\n3\tfrom typing import Callable, Literal\n4\tfrom workshop_infrastructure.datasets.helio import HelioNetCDFDataset\n5\t\n6\t\n7\tclass FilamentDataset(HelioNetCDFDataset):\n8\t    \"\"\"\n9\t    Template child class of HelioNetCDFDataset showing how to build a downstream dataset.\n10\t    Extends the base class with a flare intensity label aligned to the Surya index.\n11\t\n12\t    All ``HelioNetCDFDataset`` keyword arguments (``index_path``, ``scalers``, ``channels``,\n13\t    ``s3_cache_dir``, etc.) are accepted via ``**kwargs`` and forwarded to the base class.\n14\t    ``load_forecast_frames`` defaults to ``False`` here (flare forecasting supplies its own\n15\t    labels, so future Surya frames are never fetched); pass it explicitly to override.\n16\t\n17\t    Additional Args:\n18\t        return_surya_stack: If True (default), include the Surya image stack in the returned dict.\n19\t            Set to False to return only the flare intensity label (useful for label inspection).\n20\t        max_number_of_samples: Cap the dataset length at this value. Useful for quick experiments.\n21\t        label_transform: Optional callable applied to the ``intensity`` column of the flare index\n22\t            to produce the ``normalized_intensity`` label. Signature:\n23\t            ``(series: pd.Series) -> pd.Series``.  If ``None``, the raw intensity values are\n24\t            used as-is. Define this at the call site (e.g., in ``build_datasets()``) to keep\n25\t            normalization logic out of the dataset class.\n26\t        flare_index_path: Path to the downstream flare intensity CSV index.\n27\t        ds_time_column: Column name in the flare index to use as the event timestamp.\n28\t        ds_time_tolerance: Maximum allowed time offset when matching Surya and DS indices\n29\t            (e.g., ``\"15min\"``). Unmatched entries are dropped.\n30\t        ds_match_direction: Merge direction passed to ``pd.merge_asof``. Use ``\"forward\"``\n31\t            for causal prediction (predict flares from prior solar state).\n32\t\n33\t    Raises:\n34\t        ValueError: If ``filament_index_path`` is not provided, or if no overlap exists\n35\t            between the Surya and DS indices within the specified tolerance.\n36\t    \"\"\"\n37\t\n38\t    def __init__(\n39\t        self,\n40\t        # Downstream-specific parameters\n41\t        return_surya_stack: bool = True,\n42\t        max_number_of_samples: int | None = None,\n43\t        label_transform: Callable[[pd.Series], pd.Series] | None = None,\n44\t        filament_index_path: str | None = None,\n45\t        ds_time_column: str | None = None,\n46\t        ds_time_tolerance: str | None = None,\n47\t        ds_match_direction: Literal[\"forward\", \"backward\", \"nearest\"] = \"forward\",\n48\t        # All HelioNetCDFDataset parameters (index_path, scalers, channels, s3_*, etc.)\n49\t        **kwargs,\n50\t    ):\n51\t        if ds_match_direction not in [\"forward\", \"backward\", \"nearest\"]:\n52\t            raise ValueError(\"ds_match_direction must be one of 'forward', 'backward', or 'nearest'\")\n53\t\n54\t        # load_forecast_frames defaults to False here: flare forecasting supplies its\n55\t        # own labels, so future Surya frames never need to be fetched from disk/S3.\n56\t        kwargs.setdefault(\"load_forecast_frames\", False)\n57\t        super().__init__(**kwargs)\n58\t\n59\t        self.return_surya_stack = return_surya_stack\n60\t\n61\t        # Load ds index and find intersection with Surya index\n62\t        if filament_index_path is not None:\n63\t            self.ds_index = pd.read_csv(filament_index_path)\n64\t        else:\n65\t            raise ValueError(\"filament_index_path must be provided for FilamentDataset\")\n66\t\n67\t        # self.ds_index = pd.read_csv(ds_flare_index_path)\n68\t\n69\t        # self.ds_index[\"hemisphere\"] = self.ds_index[\"hemisphere\"].str.lower()\n70\t\n71\t        # self.ds_index[\"label\"] = self.ds_index[\"hemisphere\"].map({\n72\t        #     \"north\": 0,\n73\t        #     \"south\": 1,\n74\t        # })\n75\t\n76\t        if not self.ds_index[\"hemisphere\"].isin([0, 1]).all():\n77\t            raise ValueError(\"hemisphere column must contain only 0 or 1\")\n78\t        self.ds_index[\"label\"] = self.ds_index[\"hemisphere\"].astype(np.float32)\n79\t\n80\t        if self.ds_index[\"label\"].isna().any():\n81\t            raise ValueError(\"Hemisphere must be either 'North' or 'South'\")\n82\t\n83\t        self.ds_index[\"ds_index\"] = pd.to_datetime(\n84\t            self.ds_index[ds_time_column]\n85\t        ).values.astype(\"datetime64[ns]\")\n86\t        self.ds_index.sort_values(\"ds_index\", inplace=True)\n87\t\n88\t        # Create Surya valid indices and find closest match to DS index\n89\t        self.df_valid_indices = pd.DataFrame(\n90\t            {\"valid_indices\": self.valid_indices}\n91\t        ).sort_values(\"valid_indices\")\n92\t        self.df_valid_indices = pd.merge_asof(\n93\t            self.df_valid_indices,\n94\t            self.ds_index,\n95\t            right_on=\"ds_index\",\n96\t            left_on=\"valid_indices\",\n97\t            direction=ds_match_direction,\n98\t        )\n99\t        # Remove duplicates keeping closest match\n100\t        self.df_valid_indices[\"index_delta\"] = np.abs(\n101\t            self.df_valid_indices[\"valid_indices\"] - self.df_valid_indices[\"ds_index\"]\n102\t        )\n103\t        self.df_valid_indices = self.df_valid_indices.sort_values(\n104\t            [\"ds_index\", \"index_delta\"]\n105\t        )\n106\t        self.df_valid_indices.drop_duplicates(\n107\t            subset=\"ds_index\", keep=\"first\", inplace=True\n108\t        )\n109\t        # Enforce a maximum time tolerance for matches\n110\t        if ds_time_tolerance is not None:\n111\t            self.df_valid_indices = self.df_valid_indices.loc[\n112\t                self.df_valid_indices[\"index_delta\"] <= pd.Timedelta(ds_time_tolerance),\n113\t                :,\n114\t            ]\n115\t            if len(self.df_valid_indices) == 0:\n116\t                raise ValueError(\"No intersection between Surya and DS indices\")\n117\t\n118\t        # Override valid indices variables to reflect matches between Surya and DS\n119\t        self.valid_indices = [\n120\t            pd.Timestamp(date) for date in self.df_valid_indices[\"valid_indices\"]\n121\t        ]\n122\t        self.adjusted_length = len(self.valid_indices)\n123\t        self.df_valid_indices.set_index(\"valid_indices\", inplace=True)\n124\t\n125\t        if max_number_of_samples is not None and max_number_of_samples < self.adjusted_length:\n126\t            self.valid_indices = self.valid_indices[:max_number_of_samples]\n127\t            self.df_valid_indices = self.df_valid_indices.iloc[:max_number_of_samples]\n128\t            self.adjusted_length = max_number_of_samples\n129\t\n130\t    def __len__(self):\n131\t        return self.adjusted_length\n132\t\n133\t    def __getitem__(self, idx: int) -> dict:\n134\t        \"\"\"\n135\t        Args:\n136\t            idx: Dataset index.\n137\t\n138\t        Returns:\n139\t            Dictionary containing:\n140\t                forecast (np.float32): Normalized log10 flare intensity label.\n141\t                ds_index (str): ISO-format timestamp from the flare index.\n142\t            When ``return_surya_stack=True``, also includes all keys from\n143\t            ``HelioNetCDFDataset.__getitem__`` (ts, time_delta_input, lead_time_delta, etc.).\n144\t        \"\"\"\n145\t        sample = super().__getitem__(idx=idx) if self.return_surya_stack else {}\n146\t        sample[\"forecast\"] = np.float32(self.df_valid_indices.iloc[idx][\"label\"])\n147\t        sample[\"ds_index\"] = self.df_valid_indices[\"ds_index\"].iloc[idx].isoformat()\n148\t        return sample\n149\t\n150\t\n151\t\n152\t",
            "locations": [
