            "status": "completed",
            "raw_output": "19:class HelioSpectformer1D(nn.Module):\n28:    def __init__(\n35:        time_embedding: dict,\n69:            time_embedding=time_embedding,\n116:    def forward(self, batch):\n158:            time_embedding=dataclasses.asdict(cfg.time_embedding),\n180:class HelioSpectformer2D(nn.Module):\n187:    def __init__(\n194:        time_embedding: dict,\n219:            time_embedding=time_embedding,\n253:    def forward(self, batch):\n270:            time_embedding=dataclasses.asdict(cfg.time_embedding),",
            "raw_input": {
