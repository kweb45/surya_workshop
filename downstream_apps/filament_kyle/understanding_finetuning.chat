            },
            "title": "cd surya_workshop && sed -n '196,228p' workshop_infrastructure/models/finetune_models.py; echo \"=== discover_head_modules ===\"; grep -n -A25 \"def discover_head_modules\" workshop_infrastructure/utils.py"
          }
        ]
