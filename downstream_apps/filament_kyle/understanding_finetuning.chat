tr:,}\")\nprint(\"\\n=== TIER 1 for contrast: class_token, penultimate=True ===\")\nm1 = build(\"class_token\", True)\nprint(\"modules_to_save   :\", discover_head_modules(m1))\nhp1 = sum(p.numel() for n,p in m1.named_parameters() if n.startswith(\"head_\"))\nprint(f\"head params (D=64): {hp1}  -> at D=1280: {1280*1280+1280 + 1280+1 + 1280}\")\nPY"
