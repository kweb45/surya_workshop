              "command": "cd /home/jovyan/surya_workshop && python - <<'PY'\nimport math\n# --- cosine+warmup schedule, exactly as the notebook defines it ---\ntotal, warm = 120, 12\ndef lr_scale(step):\n    if step < warm: return (step + 1) / max(1, warm)\n    d = max(1, total - warm)\n    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, (step - warm) / d)))\nvals = [lr_scale(s) for s in range(total)]\nprint(\"warmup  :\", [f\"{v:.3f}\" for v in vals[:13]])\nprint(\"mid     :\", [f\"{v:.3f}\" for v in vals[58:63]])\nprint(\"tail    :\", [f\"{v:.4f}\" for v in vals[-4:]])\nprint(f\"max {max(vals):.4f} at step {vals.index(max(vals))} | min {min(vals):.5f} | monotone after warmup:\",\n      all(vals[i] >= vals[i+1] for i in range(warm, total-1)))\nPY"
