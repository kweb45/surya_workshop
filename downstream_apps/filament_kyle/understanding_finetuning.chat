            "raw_input": {
              "command": "cd /home/jovyan/surya_workshop && python - <<'PY'\nimport re, pathlib\nsrc = pathlib.Path('/tmp/cfg_head.yaml').read_text()\ndst = pathlib.Path('downstream_apps/filament_kyle/configs/config_script.yaml')\n\nsubs = [\n    (\"  filament_index_path: ../data/basic_fil_data.csv\",\n     \"  filament_index_path: ../data/full_fil_data.csv\"),\n    (\"  max_samples: 10                 # Cap dataset size for quick experiments (null = all samples)\",\n     \"  max_samples: null               # Cap dataset size for quick experiments (null = all samples)\"),\n    (\"    target_modules: [q_proj, v_proj, k_proj, out_proj, fc1, fc2]\",\n     \"    # fc1/fc2 in all 10 blocks; attn.qkv/attn.proj in the 8 attention blocks.\\n\"\n     \"    # These are Surya's own module names. The HuggingFace-style names this config\\n\"\n     \"    # previously carried ([q_proj, v_proj, k_proj, out_proj]) matched NOTHING in this\\n\"\n     \"    # backbone, and PEFT only raises when *no* entry matches anything at all -- so the\\n\"\n     \"    # attention layers were silently never adapted. Dotted names are required: a bare\\n\"\n     \"    # \\\"proj\\\" would also match the Conv2d patch-embedding tokenizer at\\n\"\n     \"    # embedding.patch_embed.proj. Never adapted: the spectral blocks' complex_weight,\\n\"\n     \"    # attn.to_dynamic_projection, and the patch embedding.\\n\"\n     \"    target_modules: [fc1, fc2, attn.qkv, attn.proj]\"),\n    (\"  batch_size: 2         # Per-device batch size under DDP\",\n     \"  batch_size: 1         # Per-device batch size under DDP\"),\n    (\"  deterministic: false\", \"  deterministic: warn\"),\n    (\"  wandb_project: template_flare_regression\", \"  wandb_project: filament_chirality\"),\n]\nfor old, new in subs:\n    assert src.count(old) == 1, f\"anchor not unique/found: {old[:60]!r} -> {src.count(old)}\"\n    src = src.replace(old, new)\ndst.write_text(src)\nprint(\"restored\", len(src), \"bytes\")\nPY"
