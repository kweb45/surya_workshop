            "title": "python -c \" import json, sys, pandas as pd, copy, tempfile, os sys.path.insert(0,'../../') from downstream_apps.filament_kyle.configs import load_filament_config cfg = load_filament_config('./configs/config_script.yaml') nb=json.load(open('noise_floor_runs.ipynb')) cell=[''.join(c['source']) for c in nb['cells'] if c['cell_type']=='code' and 'NOISE FLOOR' in ''.join(c['source'])][0] # Catalog with no split column, and a different class balance (simulating a 45-event set) d = pd.read_csv(cfg.data.filament_index_path).drop(columns=['split']) tmp = tempfile.NamedTemporaryFile(suffix='.csv', delete=False); d.to_csv(tmp.name, index=False) cfg2 = copy.deepcopy(cfg); cfg2.data.filament_index_path = tmp.name res=[dict(seed=42,epochs=5,accum=4,trainable=3157761,best_val_loss=0.2586,last_val_loss=0.2636, last_val_mse=0.2636,last_val_rrse=1054.0,last_val_accuracy=0.6667,last_train_loss=0.0099)] print('###### catalog WITHOUT a split column ######') exec(cell, dict(results=res, pd=pd, cfg=cfg2, SMOKE_TEST=True)) os.unlink(tmp.name) print() print('###### notebook-wide syntax check ######') bad=0 for i,c in enumerate(nb['cells']): if c['cell_type']!='code': continue try: compile(''.join(c['source']),f'cell{i}','exec') except SyntaxError as e: bad+=1; print(' ERROR cell',i,e) print(' syntax errors:', bad) \" 2>&1 | grep -viE \"futurewarning|warnings.warn\" | grep -vE \"^seed|^42 \"",
