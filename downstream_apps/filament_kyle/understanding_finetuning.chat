              "command": "/home/jovyan/envs/surya_ws/bin/python -c \"\nimport json, sys, pandas as pd, copy, tempfile, os\nsys.path.insert(0,'../../')\nfrom downstream_apps.filament_kyle.configs import load_filament_config\ncfg = load_filament_config('./configs/config_script.yaml')\nnb=json.load(open('noise_floor_runs.ipynb'))\ncell=[''.join(c['source']) for c in nb['cells'] if c['cell_type']=='code' and 'NOISE FLOOR' in ''.join(c['source'])][0]\n\n# Catalog with no split column, and a different class balance (simulating a 45-event set)\nd = pd.read_csv(cfg.data.filament_index_path).drop(columns=['split'])\ntmp = tempfile.NamedTemporaryFile(suffix='.csv', delete=False); d.to_csv(tmp.name, index=False)\ncfg2 = copy.deepcopy(cfg); cfg2.data.filament_index_path = tmp.name\n\nres=[dict(seed=42,epochs=5,accum=4,trainable=3157761,best_val_loss=0.2586,last_val_loss=0.2636,\n          last_val_mse=0.2636,last_val_rrse=1054.0,last_val_accuracy=0.6667,last_train_loss=0.0099)]\nprint('###### catalog WITHOUT a split column ######')\nexec(cell, dict(results=res, pd=pd, cfg=cfg2, SMOKE_TEST=True))\nos.unlink(tmp.name)\nprint()\nprint('###### notebook-wide syntax check ######')\nbad=0\nfor i,c in enumerate(nb['cells']):\n    if c['cell_type']!='code': continue\n    try: compile(''.join(c['source']),f'cell{i}','exec')\n    except SyntaxError as e: bad+=1; print('  ERROR cell',i,e)\nprint('  syntax errors:', bad)\n\" 2>&1 | grep -viE \"futurewarning|warnings.warn\" | grep -vE \"^seed|^42 \" ",
