            "title": "Read datasets/filament_dataset.py",
            "raw_output": "1\timport numpy as np\n2\timport pandas as pd\n3\tfrom typing import Callable, Literal\n4\tfrom workshop_infrastructure.datasets.helio import HelioNetCDFDataset\n5\t\n6\t\n7\tclass FilamentDataset(HelioNetCDFDataset):\n8\t    \"\"\"\n9\t    Template child class of HelioNetCDFDataset showing how to build a downstream dataset.\n10\t    Extends the base class with a filament chirality label (0 = dextral, 1 = sinistral)\n11\t    aligned to the Surya index. ``hemisphere`` is also carried through as passthrough\n12\t    metadata \u2014 it drives the Martin's Rule baseline, but is never fed to the model as an\n13\t    input feature, since that would hand it the answer this comparison is meant to test for.\n14\t\n15\t    All ``HelioNetCDFDataset`` keyword arguments (``index_path``, ``scalers``, ``channels``,\n16\t    ``s3_cache_dir``, etc.) are accepted via ``**kwargs`` and forwarded to the base class.\n17\t    ``load_forecast_frames`` defaults to ``False`` here (filament chirality supplies its own\n18\t    labels, so future Surya frames are never fetched); pass it explicitly to override.\n19\t\n20\t    Additional Args:\n21\t        return_surya_stack: If True (default), include the Surya image stack in the returned dict.\n22\t            Set to False to return only the flare intensity label (useful for label inspection).\n23\t        max_number_of_samples: Cap the dataset length at this value. Useful for quick experiments.\n24\t        label_transform: Optional callable applied to the ``intensity`` column of the flare index\n25\t            to produce the ``normalized_intensity`` label. Signature:\n26\t            ``(series: pd.Series) -> pd.Series``.  If ``None``, the raw intensity values are\n27\t            used as-is. Define this at the call site (e.g., in ``build_datasets()``) to keep\n28\t            normalization logic out of the dataset class.\n29\t        flare_index_path: Path to the downstream flare intensity CSV index.\n30\t        ds_time_column: Column name in the flare index to use as the event timestamp.\n31\t        ds_time_tolerance: Maximum allowed time offset when matching Surya and DS indices\n32\t            (e.g., ``\"15min\"``). Unmatched entries are dropped.\n33\t        ds_match_direction: Merge direction passed to ``pd.merge_asof``. Use ``\"forward\"``\n34\t            for causal prediction (predict flares from prior solar state).\n35\t\n36\t    Raises:\n37\t        ValueError: If ``filament_index_path`` is not provided, or if no overlap exists\n38\t            between the Surya and DS indices within the specified tolerance.\n39\t    \"\"\"\n40\t\n41\t    def __init__(\n42\t        self,\n43\t        # Downstream-specific parameters\n44\t        return_surya_stack: bool = True,\n45\t        max_number_of_samples: int | None = None,\n46\t        label_transform: Callable[[pd.Series], pd.Series] | None = None,\n47\t        filament_index_path: str | None = None,\n48\t        ds_time_column: str | None = None,\n49\t        ds_time_tolerance: str | None = None,\n50\t        ds_match_direction: Literal[\"forward\", \"backward\", \"nearest\"] = \"forward\",\n51\t        # All HelioNetCDFDataset parameters (index_path, scalers, channels, s3_*, etc.)\n52\t        **kwargs,\n53\t    ):\n54\t        if ds_match_direction not in [\"forward\", \"backward\", \"nearest\"]:\n55\t            raise ValueError(\"ds_match_direction must be one of 'forward', 'backward', or 'nearest'\")\n56\t\n57\t        # load_forecast_frames defaults to False here: flare forecasting supplies its\n58\t        # own labels, so future Surya frames never need to be fetched from disk/S3.\n59\t        kwargs.setdefault(\"load_forecast_frames\", False)\n60\t        super().__init__(**kwargs)\n61\t\n62\t        self.return_surya_stack = return_surya_stack\n63\t\n64\t        # Load ds index and find intersection with Surya index\n65\t        if filament_index_path is not None:\n66\t            self.ds_index = pd.read_csv(filament_index_path)\n67\t        else:\n68\t            raise ValueError(\"filament_index_path must be provided for FilamentDataset\")\n69\t\n70\t        # chirality is the prediction target. hemisphere is kept as passthrough metadata\n71\t        # only (see __getitem__) for the Martin's Rule baseline.\n72\t        if not self.ds_index[\"chirality\"].isin([0, 1]).all():\n73\t            raise ValueError(\"chirality column must contain only 0 (dextral) or 1 (sinistral)\")\n74\t        self.ds_index[\"label\"] = self.ds_index[\"chirality\"].astype(np.float32)\n75\t\n76\t        if self.ds_index[\"label\"].isna().any():\n77\t            raise ValueError(\"chirality must be either 0 (dextral) or 1 (sinistral)\")\n78\t\n79\t        self.ds_index[\"ds_index\"] = pd.to_datetime(\n80\t            self.ds_index[ds_time_column]\n81\t        ).values.astype(\"datetime64[ns]\")\n82\t        self.ds_index.sort_values(\"ds_index\", inplace=True)\n83\t\n84\t        # Create Surya valid indices and find closest match to DS index\n85\t        self.df_valid_indices = pd.DataFrame(\n86\t            {\"valid_indices\": self.valid_indices}\n87\t        ).sort_values(\"valid_indices\")\n88\t        self.df_valid_indices = pd.merge_asof(\n89\t            self.df_valid_indices,\n90\t            self.ds_index,\n91\t            right_on=\"ds_index\",\n92\t            left_on=\"valid_indices\",\n93\t            direction=ds_match_direction,\n94\t        )\n95\t        # Remove duplicates keeping closest match\n96\t        self.df_valid_indices[\"index_delta\"] = np.abs(\n97\t            self.df_valid_indices[\"valid_indices\"] - self.df_valid_indices[\"ds_index\"]\n98\t        )\n99\t        self.df_valid_indices = self.df_valid_indices.sort_values(\n100\t            [\"ds_index\", \"index_delta\"]\n101\t        )\n102\t        self.df_valid_indices.drop_duplicates(\n103\t            subset=\"ds_index\", keep=\"first\", inplace=True\n104\t        )\n105\t        # Enforce a maximum time tolerance for matches\n106\t        if ds_time_tolerance is not None:\n107\t            self.df_valid_indices = self.df_valid_indices.loc[\n108\t                self.df_valid_indices[\"index_delta\"] <= pd.Timedelta(ds_time_tolerance),\n109\t                :,\n110\t            ]\n111\t            if len(self.df_valid_indices) == 0:\n112\t                raise ValueError(\"No intersection between Surya and DS indices\")\n113\t\n114\t        # Override valid indices variables to reflect matches between Surya and DS\n115\t        self.valid_indices = [\n116\t            pd.Timestamp(date) for date in self.df_valid_indices[\"valid_indices\"]\n117\t        ]\n118\t        self.adjusted_length = len(self.valid_indices)\n119\t        self.df_valid_indices.set_index(\"valid_indices\", inplace=True)\n120\t\n121\t        if max_number_of_samples is not None and max_number_of_samples < self.adjusted_length:\n122\t            self.valid_indices = self.valid_indices[:max_number_of_samples]\n123\t            self.df_valid_indices = self.df_valid_indices.iloc[:max_number_of_samples]\n124\t            self.adjusted_length = max_number_of_samples\n125\t\n126\t    def __len__(self):\n127\t        return self.adjusted_length\n128\t\n129\t    def __getitem__(self, idx: int) -> dict:\n130\t        \"\"\"\n131\t        Args:\n132\t            idx: Dataset index.\n133\t\n134\t        Returns:\n135\t            Dictionary containing:\n136\t                forecast (np.float32): Chirality label (0 = dextral, 1 = sinistral).\n137\t                hemisphere (int): Passthrough metadata (0/1), not a model input \u2014 used for\n138\t                    the Martin's Rule baseline and for reporting accuracy split by hemisphere.\n139\t                ds_index (str): ISO-format timestamp from the filament index.\n140\t            When ``return_surya_stack=True``, also includes all keys from\n141\t            ``HelioNetCDFDataset.__getitem__`` (ts, time_delta_input, lead_time_delta, etc.).\n142\t        \"\"\"\n143\t        sample = super().__getitem__(idx=idx) if self.return_surya_stack else {}\n144\t        sample[\"forecast\"] = np.float32(self.df_valid_indices.iloc[idx][\"label\"])\n145\t        sample[\"hemisphere\"] = int(self.df_valid_indices.iloc[idx][\"hemisphere\"])\n146\t        sample[\"ds_index\"] = self.df_valid_indices[\"ds_index\"].iloc[idx].isoformat()\n147\t        return sample\n148\t\n149\t\n150\t\n151\t",
            "raw_input": {
