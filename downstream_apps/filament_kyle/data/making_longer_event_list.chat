            "raw_output": "rows: 34 | blanks: 0 | any NaN: False | dup ts: 0\ndtypes: int64 int64\noverlap train/val: set()\n\nsame-label pairs straddling train/val, within 30 days:\n  2010-08-01T13:42:05 [val] <-> 2010-08-14T10:12:05 [train]  gap=12 days 20:30:00\n  2012-06-14T14:12:07 [train] <-> 2012-07-12T16:48:05 [val]  gap=28 days 02:35:58\n  2012-08-14T01:25:49 [val] <-> 2012-09-02T04:00:06 [train]  gap=19 days 02:34:17\n  2015-12-16T09:36:04 [val] <-> 2015-12-28T12:12:05 [train]  gap=12 days 02:36:01\n\nMartin's Rule:\n  train n=23  acc=0.609\n  val   n=11  acc=0.545\n  all   n=34  acc=0.588\n\ntrain: 23 catalog -> 23 matched, max gap 0 days 00:06:26, missing S3 0\nval  : 11 catalog -> 11 matched, max gap 0 days 01:00:05, missing S3 0\nShell cwd was reset to /home/jovyan/surya_workshop/downstream_apps/filament_kyle/data",
            "title": "cd surya_workshop && python - <<'PY' import pandas as pd, itertools, boto3 from botocore import UNSIGNED from botocore.config import Config f = pd.read_csv(\"downstream_apps/filament_kyle/data/full_fil_data.csv\") f[\"ts\"] = pd.to_datetime(f.start_time) print(\"rows:\", len(f), \"| blanks:\", f.isna().all(axis=1).sum(), \"| any NaN:\", f.isna().any().any(), \"| dup ts:\", f.start_time.duplicated().sum()) print(\"dtypes:\", f.hemisphere.dtype, f.chirality.dtype) print(\"overlap train/val:\", set(f[f.split=='train'].start_time) & set(f[f.split=='val'].start_time)) print(\"\\nsame-label pairs straddling train/val, within 30 days:\") for (_,a),(_,b) in itertools.combinations(f.iterrows(), 2): g = abs(b.ts-a.ts) if g <= pd.Timedelta(\"30d\") and a.split!=b.split and a.hemisphere==b.hemisphere and a.chirality==b.chirality: print(f\" {a.start_time} [{a.split}] <-> {b.start_time} [{b.split}] gap={g}\") print(\"\\nMartin's Rule:\") for s, r in f.groupby(\"split\"): print(f\" {s:5s} n={len(r):2d} acc={(r.chirality==r.hemisphere).mean():.3f}\") print(f\" all n={len(f):2d} acc={(f.chirality==f.hemisphere).mean():.3f}\") idx = pd.read_csv(\"data/indices/surya_aws_s3_full_index.csv\", usecols=[\"path\",\"timestep\",\"present\"]) idx[\"timestep\"] = pd.to_datetime(idx.timestep); idx = idx[idx.present==1] v = idx[[\"timestep\",\"path\"]].rename(columns={\"timestep\":\"valid_indices\"}).sort_values(\"valid_indices\") s3 = boto3.client(\"s3\", config=Config(signature_version=UNSIGNED)) print() for phase in [\"train\",\"val\"]: sub = f[f.split==phase].rename(columns={\"ts\":\"ds_index\"}).sort_values(\"ds_index\") m = pd.merge_asof(v, sub, right_on=\"ds_index\", left_on=\"valid_indices\", direction=\"forward\") m[\"d\"] = (m.valid_indices - m.ds_index).abs() m = m.sort_values([\"ds_index\",\"d\"]).drop_duplicates(\"ds_index\",keep=\"first\").dropna(subset=[\"ds_index\"]) kept = m[m.d <= pd.Timedelta(\"2d\")] bad = [] for p in kept.path: b,k = p.replace(\"s3://\",\"\").split(\"/\",1) try: s3.head_object(Bucket=b, Key=k) except Exception: bad.append(p) print(f\"{phase:5s}: {len(sub)} catalog -> {len(kept)} matched, max gap {kept.d.max()}, missing S3 {len(bad)}\") PY",
            "status": "completed",
            "kind": "execute",
            "raw_input": {
              "description": "Validate final catalog end to end",
              "command": "cd /home/jovyan/surya_workshop && python - <<'PY'\nimport pandas as pd, itertools, boto3\nfrom botocore import UNSIGNED\nfrom botocore.config import Config\n\nf = pd.read_csv(\"downstream_apps/filament_kyle/data/full_fil_data.csv\")\nf[\"ts\"] = pd.to_datetime(f.start_time)\nprint(\"rows:\", len(f), \"| blanks:\", f.isna().all(axis=1).sum(),\n      \"| any NaN:\", f.isna().any().any(), \"| dup ts:\", f.start_time.duplicated().sum())\nprint(\"dtypes:\", f.hemisphere.dtype, f.chirality.dtype)\nprint(\"overlap train/val:\", set(f[f.split=='train'].start_time) & set(f[f.split=='val'].start_time))\n\nprint(\"\\nsame-label pairs straddling train/val, within 30 days:\")\nfor (_,a),(_,b) in itertools.combinations(f.iterrows(), 2):\n    g = abs(b.ts-a.ts)\n    if g <= pd.Timedelta(\"30d\") and a.split!=b.split and a.hemisphere==b.hemisphere and a.chirality==b.chirality:\n        print(f\"  {a.start_time} [{a.split}] <-> {b.start_time} [{b.split}]  gap={g}\")\n\nprint(\"\\nMartin's Rule:\")\nfor s, r in f.groupby(\"split\"):\n    print(f\"  {s:5s} n={len(r):2d}  acc={(r.chirality==r.hemisphere).mean():.3f}\")\nprint(f\"  all   n={len(f):2d}  acc={(f.chirality==f.hemisphere).mean():.3f}\")\n\nidx = pd.read_csv(\"data/indices/surya_aws_s3_full_index.csv\", usecols=[\"path\",\"timestep\",\"present\"])\nidx[\"timestep\"] = pd.to_datetime(idx.timestep); idx = idx[idx.present==1]\nv = idx[[\"timestep\",\"path\"]].rename(columns={\"timestep\":\"valid_indices\"}).sort_values(\"valid_indices\")\ns3 = boto3.client(\"s3\", config=Config(signature_version=UNSIGNED))\nprint()\nfor phase in [\"train\",\"val\"]:\n    sub = f[f.split==phase].rename(columns={\"ts\":\"ds_index\"}).sort_values(\"ds_index\")\n    m = pd.merge_asof(v, sub, right_on=\"ds_index\", left_on=\"valid_indices\", direction=\"forward\")\n    m[\"d\"] = (m.valid_indices - m.ds_index).abs()\n    m = m.sort_values([\"ds_index\",\"d\"]).drop_duplicates(\"ds_index\",keep=\"first\").dropna(subset=[\"ds_index\"])\n    kept = m[m.d <= pd.Timedelta(\"2d\")]\n    bad = []\n    for p in kept.path:\n        b,k = p.replace(\"s3://\",\"\").split(\"/\",1)\n        try: s3.head_object(Bucket=b, Key=k)\n        except Exception: bad.append(p)\n    print(f\"{phase:5s}: {len(sub)} catalog -> {len(kept)} matched, max gap {kept.d.max()}, missing S3 {len(bad)}\")\nPY"
            },
